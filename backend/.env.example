# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Database Connection (MongoDB Atlas in production)
MONGODB_URI=mongodb://127.0.0.1:27017/careerpilot

# Authentication (JWT) - Minimum 32 random characters
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# File Storage Configuration (local or s3)
STORAGE_DRIVER=local

# S3 / Cloudflare R2 Cloud Object Storage (optional, when STORAGE_DRIVER=s3)
S3_BUCKET=your_s3_bucket_name
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key

# Email Configuration
EMAIL_FROM=noreply@careerpilot.app
